+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/mojom/ui_base_types.mojom-shared.h"
+#include "ui/views/bubble/bubble_dialog_model_host.h"
+
+namespace helium {
+namespace {
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kTabNameTextfield);
+
+class TabRenameDialogDelegate : public ui::DialogModelDelegate {
+ public:
+  explicit TabRenameDialogDelegate(TabRenameCallback callback)
+      : callback_(std::move(callback)) {}
+
+  TabRenameDialogDelegate(const TabRenameDialogDelegate&) = delete;
+  TabRenameDialogDelegate& operator=(const TabRenameDialogDelegate&) = delete;
+  ~TabRenameDialogDelegate() override = default;
+
+  void OnAccepted() {
+    std::move(callback_).Run(
+        dialog_model()->GetTextfieldByUniqueId(kTabNameTextfield)->text());
+  }
+
+ private:
+  TabRenameCallback callback_;
+};
+
+}  // namespace
+
+void ShowTabRenameDialog(content::WebContents* web_contents,
+                         std::u16string initial_title,
+                         TabRenameCallback callback) {
+  if (!web_contents) {
+    return;
+  }
+
+  auto delegate = std::make_unique<TabRenameDialogDelegate>(std::move(callback));
+  auto* delegate_ptr = delegate.get();
+  auto dialog_model =
+      ui::DialogModel::Builder(std::move(delegate))
+          .SetTitle(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_RENAMETAB))
+          .AddTextfield(
+              kTabNameTextfield,
+              l10n_util::GetStringUTF16(IDS_TAB_RENAME_DIALOG_PLACEHOLDER),
+              std::move(initial_title))
+          .AddOkButton(base::BindOnce(&TabRenameDialogDelegate::OnAccepted,
+                                      base::Unretained(delegate_ptr)))
+          .AddCancelButton(base::DoNothing())
+          .Build();
+  auto dialog = views::BubbleDialogModelHost::CreateModal(
+      std::move(dialog_model), ui::mojom::ModalType::kChild);
+  constrained_window::ShowWebModalDialogViews(dialog.release(), web_contents);
+}
+
+}  // namespace helium
