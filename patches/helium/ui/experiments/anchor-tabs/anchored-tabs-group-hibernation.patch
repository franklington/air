+  return orientation_ == TabStripOrientation::kVertical &&
+         features::IsHeliumAnchoredTabsEnabled();
+}
+
+void TabGroupView::OnChildTabStateChanged() {
+  if (!collection_node_ || !IsCollapsed() || !IsAnchoredVerticalGroup()) {
+    return;
+  }
+  UpdateChildVisibilityForCollapseState(true);
+  group_header_->UpdateHibernateButtonVisibility();
+  InvalidateLayout();
+}
+
+bool TabGroupView::ShouldShowHibernateButton() const {
+  if (!collection_node_ || !IsCollapsed() || !IsAnchoredVerticalGroup()) {
+    return false;
+  }
+  for (auto* child : collection_node_->GetDirectChildren()) {
+    if (auto* tab_view = views::AsViewClass<TabView>(child)) {
+      if (tab_view->GetVisible() && !tab_view->data().is_tab_discarded) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+void TabGroupView::HibernateRemainingTabs() {
+  if (!collection_node_) {
+    return;
+  }
+  helium::HibernateTabGroup(collection_node_->GetController()->GetModel(),
+                            GetTabGroupFromNode(collection_node_)->id());
+  OnDataChanged();
+}
