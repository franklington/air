+
+std::unique_ptr<views::View> UnpinnedTabContainerView::RemoveMiddlePinnedView() {
+  if (!middle_pinned_view_) {
+    return nullptr;
+  }
+  views::View* view = std::exchange(middle_pinned_view_, nullptr);
+  return RemoveChildViewT(view);
+}
+
+void UnpinnedTabContainerView::SetClearButtonHoverState(bool hovered) {
+  if (!clear_ungrouped_tabs_button_) {
+    return;
+  }
+
+  hovered = hovered && features::IsHeliumAnchoredTabsEnabled() &&
+            GetTabStripCollapseState() ==
+                tabs::VerticalTabStripCollapseState::kExpanded;
+  if (clear_ungrouped_tabs_hovered_ == hovered) {
+    return;
+  }
+
+  clear_ungrouped_tabs_hovered_ = hovered;
+  clear_ungrouped_tabs_button_->SetText(
+      hovered ? l10n_util::GetStringUTF16(IDS_VERTICAL_TABS_CLEAR_UNGROUPED)
+              : std::u16string());
+  clear_ungrouped_tabs_button_->SetEnabled(hovered);
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void UnpinnedTabContainerView::CloseUngroupedTabs() {
+  if (!features::IsHeliumAnchoredTabsEnabled() || !collection_node_ ||
+      !collection_node_->GetController()) {
+    return;
+  }
+
+  TabStripModel* const model = collection_node_->GetController()->GetModel();
+  if (!model) {
+    return;
+  }
+
+  for (int i = model->count() - 1; i >= 0; --i) {
+    if (!model->IsTabPinned(i) && !model->GetTabGroupForTab(i).has_value()) {
+      model->CloseWebContentsAt(i,
+                                TabCloseTypes::CLOSE_USER_GESTURE |
+                                    TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+}
